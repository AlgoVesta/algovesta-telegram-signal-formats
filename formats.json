{
  "note": "All messages are synthetic. They imitate formats seen in public signal channels; none is copied from a real channel. Each 'expect' block is the output of AlgoVesta's parser for that exact text, checked before every change to this file.",
  "fields": {
    "market": "forex = MetaTrader 5 symbols (FX pairs, metals, indices); crypto = exchange perpetuals and spot",
    "intent": "forex only. ENTRY = a new trade; RESULT = a report about a trade that already happened; MANAGEMENT = an instruction about an open trade; NONE = no symbol found",
    "symbol": "canonical symbol without broker or exchange suffix",
    "side": "buy or sell",
    "entry": "single entry price, or null for a market order without a price",
    "entry_range": "[low, high] when the message gives a zone, else null",
    "sl": "stop-loss price, or null when the message has none (the bot's own stop-loss setting is used)",
    "tp_list": "take-profit prices in the order given",
    "order_type": "forex only: market, limit or stop",
    "leverage": "crypto only, when the message states it"
  },
  "formats": [
    {"id": "F01", "market": "forex", "name": "symbol, side and @ price, numbered TPs",
     "text": "XAUUSD SELL @ 2641.50\nSL 2648.00\nTP1 2636.00\nTP2 2630.00\nTP3 2622.00",
     "expect": {"intent": "ENTRY", "symbol": "XAUUSD", "side": "sell", "entry": 2641.5, "entry_range": null, "sl": 2648.0, "tp_list": [2636.0, 2630.0, 2622.0], "order_type": "market"}},
    {"id": "F02", "market": "forex", "name": "buy now, lower-case labels",
     "text": "EURUSD buy now 1.0842\nsl 1.0810\ntp 1.0880",
     "expect": {"intent": "ENTRY", "symbol": "EURUSD", "side": "buy", "entry": null, "entry_range": null, "sl": 1.081, "tp_list": [1.088], "order_type": "market"}},
    {"id": "F03", "market": "forex", "name": "sell limit, comma-separated TPs",
     "text": "GBPJPY SELL LIMIT 193.40\nSL: 194.10\nTP: 192.60, 191.90",
     "expect": {"intent": "ENTRY", "symbol": "GBPJPY", "side": "sell", "entry": 193.4, "entry_range": null, "sl": 194.1, "tp_list": [192.6, 191.9], "order_type": "limit"}},
    {"id": "F04", "market": "forex", "name": "labels with a trailing dot",
     "text": "USDJPY\nBUY 156.20\nSL. 155.70\nTP. 156.90\nTP. 157.40",
     "expect": {"intent": "ENTRY", "symbol": "USDJPY", "side": "buy", "entry": 156.2, "entry_range": null, "sl": 155.7, "tp_list": [156.9, 157.4], "order_type": "market"}},
    {"id": "F05", "market": "forex", "name": "Gold alias, entry zone, numbered target list",
     "text": "Gold buy 2628-2625\nStop 2619\nProfit targets:\n1) 2633\n2) 2638\n3) 2645",
     "expect": {"intent": "ENTRY", "symbol": "XAUUSD", "side": "buy", "entry": 2626.5, "entry_range": [2625.0, 2628.0], "sl": 2619.0, "tp_list": [2633.0, 2638.0, 2645.0], "order_type": "stop"}},
    {"id": "F06", "market": "forex", "name": "emoji bullets",
     "text": "🟢 BUY EURJPY 162.85\n🔴 SL 162.35\n🎯 TP 163.60",
     "expect": {"intent": "ENTRY", "symbol": "EURJPY", "side": "buy", "entry": 162.85, "entry_range": null, "sl": 162.35, "tp_list": [163.6], "order_type": "market"}},
    {"id": "F07", "market": "forex", "name": "short with spelled-out labels",
     "text": "AUDUSD short\n@0.6520\nstop loss 0.6555\ntake profit 0.6480",
     "expect": {"intent": "ENTRY", "symbol": "AUDUSD", "side": "sell", "entry": 0.652, "entry_range": null, "sl": 0.6555, "tp_list": [0.648], "order_type": "market"}},
    {"id": "F08", "market": "forex", "name": "index symbol, slash-separated TPs",
     "text": "US30 sell 42310\nsl 42460\ntp 42150 / 42000",
     "expect": {"intent": "ENTRY", "symbol": "US30", "side": "sell", "entry": 42310.0, "entry_range": null, "sl": 42460.0, "tp_list": [42150.0, 42000.0], "order_type": "market"}},
    {"id": "F09", "market": "forex", "name": "one value per line, four TPs",
     "text": "NZDUSD\nSELL\nEntry 0.5905\nSL 0.5935\nTP1 0.5880\nTP2 0.5860\nTP3 0.5830\nTP4 0.5800",
     "expect": {"intent": "ENTRY", "symbol": "NZDUSD", "side": "sell", "entry": 0.5905, "entry_range": null, "sl": 0.5935, "tp_list": [0.588, 0.586, 0.583, 0.58], "order_type": "market"}},
    {"id": "F10", "market": "forex", "name": "GOLD on its own line, sell limit with @",
     "text": "GOLD\nSELL LIMIT @ 2655.0\nSL 2662.0\nTP 2645.0\nTP 2636.0",
     "expect": {"intent": "ENTRY", "symbol": "XAUUSD", "side": "sell", "entry": 2655.0, "entry_range": null, "sl": 2662.0, "tp_list": [2645.0, 2636.0], "order_type": "limit"}},
    {"id": "F11", "market": "forex", "name": "zone written high to low",
     "text": "CADJPY buy 108.60-108.40\nSL 107.95\nTP 109.20, 109.80",
     "expect": {"intent": "ENTRY", "symbol": "CADJPY", "side": "buy", "entry": 108.5, "entry_range": [108.4, 108.6], "sl": 107.95, "tp_list": [109.2, 109.8], "order_type": "market"}},
    {"id": "F12", "market": "forex", "name": "everything on one line",
     "text": "SELL EURGBP 0.8372 sl 0.8395 tp 0.8340",
     "expect": {"intent": "ENTRY", "symbol": "EURGBP", "side": "sell", "entry": 0.8372, "entry_range": null, "sl": 0.8395, "tp_list": [0.834], "order_type": "market"}},
    {"id": "F13", "market": "forex", "name": "five targets",
     "text": "XAUUSD buy 2602.3\nSL 2596.8\nTP1 2606.0\nTP2 2609.5\nTP3 2614.0\nTP4 2620.0\nTP5 2628.0",
     "expect": {"intent": "ENTRY", "symbol": "XAUUSD", "side": "buy", "entry": 2602.3, "entry_range": null, "sl": 2596.8, "tp_list": [2606.0, 2609.5, 2614.0, 2620.0, 2628.0], "order_type": "market"}},
    {"id": "N01", "market": "forex", "name": "result post is not an entry",
     "text": "TP1 hit on GBPUSD ✅ +40 pips, congratulations everyone",
     "expect": {"intent": "RESULT"}},
    {"id": "N02", "market": "forex", "name": "partial close instruction is management, not an entry",
     "text": "Close half of the XAUUSD position, move SL to entry",
     "expect": {"intent": "MANAGEMENT"}},
    {"id": "N03", "market": "forex", "name": "recap without a symbol",
     "text": "Weekly recap: 7 wins, 2 losses, +412 pips. Next signals tomorrow.",
     "expect": {"intent": "NONE"}},
    {"id": "C01", "market": "crypto", "name": "pair with slash, labelled lines, numbered targets, leverage",
     "text": "BTC/USDT LONG\nEntry: 67400\nStop loss: 66300\nTarget 1: 68500\nTarget 2: 69200\nLeverage: 10x",
     "expect": {"symbol": "BTCUSDT", "side": "buy", "entry": 67400, "sl": 66300, "tp_list": [68500, 69200], "leverage": 10}},
    {"id": "C02", "market": "crypto", "name": "hashtag pair, SL and TP1/TP2 labels",
     "text": "#SOL/USDT SHORT\nEntry: 142.8\nSL: 146.4\nTP1: 140.5\nTP2: 138.2",
     "expect": {"symbol": "SOLUSDT", "side": "sell", "entry": 142.8, "sl": 146.4, "tp_list": [140.5, 138.2]}},
    {"id": "C03", "market": "crypto", "name": "hashtag and direction only",
     "text": "#ETH SHORT",
     "expect": {"symbol": "ETHUSDT", "side": "sell", "entry": null, "sl": null, "tp_list": []}},
    {"id": "C04", "market": "crypto", "name": "long without leverage",
     "text": "ETH/USDT LONG\nEntry: 3420\nStop loss: 3350\nTarget 1: 3520\nTarget 2: 3610",
     "expect": {"symbol": "ETHUSDT", "side": "buy", "entry": 3420, "sl": 3350, "tp_list": [3520, 3610]}}
  ]
}
